diff --git a/guest/tests/test_wau_os.py b/guest/tests/test_wau_os.py
new file mode 100644
index 0000000..ba928e8
--- /dev/null
+++ b/guest/tests/test_wau_os.py
@@ -0,0 +1,221 @@
+from __future__ import annotations
+
+import hashlib
+import json
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+
+GUEST = Path(__file__).resolve().parents[1]
+OVERLAY_SCRIPT = GUEST / "scripts/apply-wau-os-overlay.sh"
+REGISTER_SCRIPT = GUEST / "scripts/register-wau-os.sh"
+
+
+def digest(payload: bytes) -> str:
+    return hashlib.sha256(payload).hexdigest()
+
+
+class ApplyWauOsOverlayTests(unittest.TestCase):
+    base = b"base\n"
+    replacement = b"replacement\n"
+    addition = b"added\n"
+
+    def fixture(self, temporary: str) -> tuple[Path, Path, Path]:
+        base = Path(temporary)
+        root = base / "root"
+        target = root / "usr/bin/omarchy-provision-first-run"
+        target.parent.mkdir(parents=True)
+        target.write_bytes(self.base)
+        source = base / "overlay/usr/bin/omarchy-provision-first-run"
+        source.parent.mkdir(parents=True)
+        source.write_bytes(self.replacement)
+        added_source = base / "overlay/usr/share/omarchy/install/user/first-run/wau-os-first-run.sh"
+        added_source.parent.mkdir(parents=True)
+        added_source.write_bytes(self.addition)
+        manifest = base / "overlay-manifest.json"
+        manifest.write_text(
+            json.dumps(
+                {
+                    "schemaVersion": 1,
+                    "files": [
+                        {
+                            "target": "usr/bin/omarchy-provision-first-run",
+                            "source": "overlay/usr/bin/omarchy-provision-first-run",
+                            "mode": "0755",
+                            "sha256": digest(self.replacement),
+                            "baseSha256": digest(self.base),
+                        },
+                        {
+                            "target": "usr/share/omarchy/install/user/first-run/wau-os-first-run.sh",
+                            "source": "overlay/usr/share/omarchy/install/user/first-run/wau-os-first-run.sh",
+                            "mode": "0755",
+                            "sha256": digest(self.addition),
+                        },
+                    ],
+                },

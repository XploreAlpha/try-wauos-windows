diff --git a/guest/scripts/register-wau-os.sh b/guest/scripts/register-wau-os.sh
new file mode 100755
index 0000000..ca008bc
--- /dev/null
+++ b/guest/scripts/register-wau-os.sh
@@ -0,0 +1,155 @@
+#!/bin/bash
+
+set -euo pipefail
+
+usage() {
+  cat <<'USAGE'
+Usage: register-wau-os.sh --root ROOT --work WORK --spec SPEC --pacman-config CONFIG --package FILE
+
+Installs the reviewed Wau OS package into the staged root and keeps an
+immutable copy in the guest's local repository. The package is verified against
+the digest recorded in the build spec, and every dependency it declares must
+already be part of the guest's locked transaction: the build never resolves an
+unreviewed package from a live repository.
+USAGE
+}
+
+fail() {
+  echo "register-wau-os: $*" >&2
+  exit 1
+}
+
+root=""
+work=""
+spec=""
+pacman_config=""
+package=""
+
+while (($#)); do
+  case "$1" in
+    --root)
+      root=${2:-}
+      shift 2
+      ;;
+    --work)
+      work=${2:-}
+      shift 2
+      ;;
+    --spec)
+      spec=${2:-}
+      shift 2
+      ;;
+    --pacman-config)
+      pacman_config=${2:-}
+      shift 2
+      ;;
+    --package)
+      package=${2:-}
+      shift 2
+      ;;
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    *)
+      fail "unknown option: $1"
+      ;;
+  esac
+done
+
+[[ $root == /* && -d $root ]] || fail "--root must be an absolute staged root"
+case "$root" in
+  /|/bin|/boot|/etc|/home|/opt|/root|/usr|/var)
+    fail "refusing unsafe root: $root"
+    ;;
+esac
+[[ $work == /* && -d $work ]] || fail "--work must be an absolute directory"
+[[ -f $spec ]] || fail "spec not found: $spec"
+[[ -f $pacman_config ]] || fail "pacman config not found: $pacman_config"
+[[ -n $package ]] || fail "--package is required"
+
+mapfile -t metadata < <(python3 - "$spec" <<'PY'
+import json
+import pathlib
+import sys
+
+spec = json.loads(pathlib.Path(sys.argv[1]).read_text())
+wau_os = spec.get("wauOs")
+if not wau_os:
+    print("disabled")
+    raise SystemExit
+print("enabled")
+for key in ("packageName", "packageVersion", "packageSha256"):
+    print(wau_os[key])
+PY
+) || fail "could not read the Wau OS package metadata from the spec"
+[[ ${metadata[0]:-} == disabled ]] && exit 0
+[[ ${metadata[0]:-} == enabled ]] || fail "invalid Wau OS package state"
+(( ${#metadata[@]} == 4 )) || fail "the Wau OS package metadata is incomplete"
+package_name=${metadata[1]}
+package_version=${metadata[2]}
+package_sha256=${metadata[3]}
+
+[[ $package_name =~ ^[a-z0-9@._+-]+$ ]] || fail "unsafe Wau OS package name: $package_name"
+[[ $package_version =~ ^[A-Za-z0-9._+:-]+$ ]] || fail "unsafe Wau OS package version: $package_version"
+[[ $package_sha256 =~ ^[0-9a-f]{64}$ ]] || fail "invalid Wau OS package digest"
+
+[[ -f $package && ! -L $package ]] || fail "Wau OS package not found: $package"
+package=$(cd "$(dirname "$package")" && pwd)/$(basename "$package")
+expected_name="$package_name-$package_version-x86_64.pkg.tar.zst"
+[[ $(basename "$package") == "$expected_name" ]] ||
+  fail "Wau OS package file does not match the pinned name: $(basename "$package")"
+
+actual_sha256=$(sha256sum "$package" | cut -d' ' -f1)
+[[ $actual_sha256 == "$package_sha256" ]] ||
+  fail "Wau OS package digest mismatch: expected $package_sha256, got $actual_sha256"
+
+for command in install pacman python3 sha256sum tar zstd; do
+  command -v "$command" >/dev/null || fail "$command is required"
+done
+
+# The package's own dependency list is the contract. Every dependency must
+# already be installed in the staged root, so the build resolves nothing from a
+# live repository and the guest's locked transaction stays complete.
+mapfile -t dependencies < <(tar --zstd -xOf "$package" .PKGINFO |
+  sed -n 's/^depend = //p' |
+  sed 's/[<>=].*$//' |
+  LC_ALL=C sort -u)
+(( ${#dependencies[@]} > 0 )) || fail "the Wau OS package declares no dependencies"
+missing=()
+for dependency in "${dependencies[@]}"; do
+  [[ -n $dependency ]] || continue
+  if ! pacman --config "$pacman_config" --root "$root" --dbpath "$root/var/lib/pacman" \
+    -Q "$dependency" >/dev/null 2>&1; then
+    missing+=("$dependency")
+  fi
+done
+if ((${#missing[@]})); then
+  fail "the Wau OS package needs packages that are not in the guest transaction: ${missing[*]}; add them to packages.txt and refresh the package lock"
+fi
+
+# The package ships a post-install message and nothing else. Skip the
+# scriptlets anyway: they run against the build host, not the staged root.
+pacman \
+  --noconfirm \
+  --noscriptlet \
+  --config "$pacman_config" \
+  --root "$root" \
+  --dbpath "$root/var/lib/pacman" \
+  --logfile "$root/var/log/pacman.log" \
+  -U "$package"
+
+query=$(pacman --config "$pacman_config" --root "$root" --dbpath "$root/var/lib/pacman" -Q "$package_name")
+[[ $query == "$package_name $package_version" ]] || fail "installed Wau OS package reports: $query"
+pacman --config "$pacman_config" --root "$root" --dbpath "$root/var/lib/pacman" -Qkk "$package_name" >/dev/null ||
+  fail "the installed Wau OS package failed its ownership check"
+pacman --config "$pacman_config" --root "$root" --dbpath "$root/var/lib/pacman" -T "${dependencies[@]}" >/dev/null ||
+  fail "the installed Wau OS package does not satisfy its dependencies"
+
+repo_dir="$root/usr/share/try-omarchy/repo"
+install -d -m 0755 "$repo_dir"
+install -m 0644 "$package" "$repo_dir/$(basename "$package")"
+# The local repository is sealed against an exact package set. Record that the
+# Wau OS package is part of this image, so the seal expects it.
+printf '%s %s\n' "$package_name" "$package_version" >"$root/usr/share/try-omarchy/wau-os-package"
+echo "Registered $query from the verified Wau OS package $package_sha256"

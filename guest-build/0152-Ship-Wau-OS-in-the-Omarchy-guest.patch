+                    }
+                },
+                indent=2,
+            )
+        )
+        return root, spec, target
+
+    def apply(self, root: Path, spec: Path) -> subprocess.CompletedProcess:
+        return subprocess.run(
+            ["bash", str(OVERLAY_SCRIPT), "--root", str(root), "--spec", str(spec)],
+            text=True,
+            capture_output=True,
+            check=False,
+        )
+
+    def test_overlay_replaces_a_reviewed_file_and_adds_a_new_one(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root, spec, target = self.fixture(temporary)
+            result = self.apply(root, spec)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(target.read_bytes(), self.replacement)
+            added = root / "usr/share/omarchy/install/user/first-run/wau-os-first-run.sh"
+            self.assertEqual(added.read_bytes(), self.addition)
+            self.assertTrue(added.stat().st_mode & 0o111, "the added script must be executable")
+
+    def test_overlay_is_idempotent(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root, spec, target = self.fixture(temporary)
+            self.assertEqual(self.apply(root, spec).returncode, 0)
+            second = self.apply(root, spec)
+            self.assertEqual(second.returncode, 0, second.stderr)
+            self.assertIn("Applied 0 Wau OS overlay file(s)", second.stdout)
+            self.assertEqual(target.read_bytes(), self.replacement)
+
+    def test_overlay_refuses_a_target_that_changed_since_it_was_reviewed(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root, spec, target = self.fixture(temporary)
+            target.write_bytes(b"somebody else changed this\n")
+            result = self.apply(root, spec)
+            self.assertNotEqual(result.returncode, 0)
+            self.assertIn("changed since it was reviewed", result.stderr)
+            self.assertEqual(target.read_bytes(), b"somebody else changed this\n")
+
+    def test_overlay_refuses_to_replace_a_file_it_did_not_review(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root, spec, target = self.fixture(temporary)
+            manifest = spec.parent / "overlay-manifest.json"
+            payload = json.loads(manifest.read_text())
+            del payload["files"][0]["baseSha256"]
+            manifest.write_text(json.dumps(payload, indent=2))
+            result = self.apply(root, spec)
+            self.assertNotEqual(result.returncode, 0)
+            self.assertIn("already exists", result.stderr)
+            self.assertEqual(target.read_bytes(), self.base)
+
+    def test_overlay_refuses_a_source_that_does_not_match_its_digest(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root, spec, target = self.fixture(temporary)
+            source = spec.parent / "overlay/usr/bin/omarchy-provision-first-run"
+            source.write_bytes(b"tampered\n")
+            result = self.apply(root, spec)
+            self.assertNotEqual(result.returncode, 0)

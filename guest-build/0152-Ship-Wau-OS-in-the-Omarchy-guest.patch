diff --git a/guest/scripts/apply-wau-os-overlay.sh b/guest/scripts/apply-wau-os-overlay.sh
new file mode 100755
index 0000000..b203b06
--- /dev/null
+++ b/guest/scripts/apply-wau-os-overlay.sh
@@ -0,0 +1,132 @@
+#!/bin/bash
+
+set -euo pipefail
+
+usage() {
+  cat <<'USAGE'
+Usage: apply-wau-os-overlay.sh --root ROOT --spec SPEC
+
+Applies the reviewed Wau OS overlay to the staged, already-verified Omarchy
+runtime. Every file in the overlay manifest carries the digest of the staged
+upstream file it replaces, so the overlay can only ever be applied to the
+pinned Omarchy revision it was reviewed against.
+USAGE
+}
+
+fail() {
+  echo "apply-wau-os-overlay: $*" >&2
+  exit 1
+}
+
+root=""
+spec=""
+
+while (($#)); do
+  case "$1" in
+    --root)
+      root=${2:-}
+      shift 2
+      ;;
+    --spec)
+      spec=${2:-}
+      shift 2
+      ;;
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    *)
+      fail "unknown option: $1"
+      ;;
+  esac
+done
+
+[[ $root == /* && -d $root ]] || fail "--root must be an absolute staged root"
+case "$root" in
+  /|/bin|/boot|/etc|/home|/opt|/root|/usr|/var)
+    fail "refusing unsafe root: $root"
+    ;;
+esac
+[[ -f $spec ]] || fail "spec not found: $spec"
+spec=$(cd "$(dirname "$spec")" && pwd)/$(basename "$spec")
+spec_dir=$(dirname "$spec")
+
+overlay_state=$(python3 -c '
+import json, sys
+spec = json.load(open(sys.argv[1]))
+overlay = spec.get("wauOs")
+if not overlay:
+    print("disabled")
+else:
+    print("enabled")
+    print(overlay["overlayManifest"])
+' "$spec") || fail "could not read the Wau OS overlay manifest from the spec"
+mapfile -t overlay_fields <<<"$overlay_state"
+[[ ${overlay_fields[0]:-} == disabled ]] && exit 0
+[[ ${overlay_fields[0]:-} == enabled ]] || fail "invalid Wau OS overlay state"
+(( ${#overlay_fields[@]} == 2 )) || fail "the Wau OS overlay manifest path is missing from the spec"
+manifest=${overlay_fields[1]}
+for command in install python3 sha256sum; do
+  command -v "$command" >/dev/null || fail "$command is required"
+done
+[[ $manifest != /* && $manifest != *..* ]] || fail "unsafe Wau OS overlay manifest path: $manifest"
+manifest_file="$spec_dir/$manifest"
+[[ -f $manifest_file ]] || fail "Wau OS overlay manifest not found: $manifest_file"
+
+applied=0
+while IFS=$'\t' read -r target source mode digest base; do
+  [[ -n $target && -n $source && -n $mode && -n $digest ]] || fail "incomplete Wau OS overlay entry"
+  [[ $target != /* && $target != *..* ]] || fail "unsafe Wau OS overlay target: $target"
+  [[ $source != /* && $source != *..* ]] || fail "unsafe Wau OS overlay source: $source"
+  [[ $mode =~ ^[0-7]{4}$ ]] || fail "invalid Wau OS overlay mode: $mode"
+
+  source_file="$spec_dir/$source"
+  [[ -f $source_file && ! -L $source_file ]] || fail "Wau OS overlay source is not a regular file: $source"
+  actual=$(sha256sum "$source_file" | cut -d' ' -f1)
+  [[ $actual == "$digest" ]] || fail "Wau OS overlay source digest mismatch: $source"
+
+  target_file="$root/$target"
+  if [[ -n $base ]]; then
+    [[ $base =~ ^[0-9a-f]{64}$ ]] || fail "invalid Wau OS overlay base digest: $target"
+    [[ -f $target_file && ! -L $target_file ]] || fail "Wau OS overlay target is missing: $target"
+    current=$(sha256sum "$target_file" | cut -d' ' -f1)
+    if [[ $current == "$digest" ]]; then
+      continue
+    fi
+    [[ $current == "$base" ]] ||
+      fail "Wau OS overlay target changed since it was reviewed: $target"
+  else
+    if [[ -e $target_file ]]; then
+      current=$(sha256sum "$target_file" | cut -d' ' -f1)
+      [[ $current == "$digest" ]] && continue
+      fail "Wau OS overlay target already exists: $target"
+    fi
+  fi
+
+  install -D -m "$mode" "$source_file" "$target_file"
+  installed=$(sha256sum "$target_file" | cut -d' ' -f1)
+  [[ $installed == "$digest" ]] || fail "Wau OS overlay digest mismatch after install: $target"
+  applied=$((applied + 1))
+done < <(python3 - "$manifest_file" <<'PY'
+import json
+import sys
+
+manifest = json.load(open(sys.argv[1]))
+if manifest.get("schemaVersion") != 1:
+    raise SystemExit("unsupported Wau OS overlay manifest schema")
+for entry in manifest.get("files", []):
+    print(
+        "\t".join(
+            [
+                str(entry["target"]),
+                str(entry["source"]),
+                str(entry["mode"]),
+                str(entry["sha256"]),
+                str(entry.get("baseSha256", "")),
+            ]
+        )
+    )
+PY
+)
+
+echo "Applied $applied Wau OS overlay file(s) to the staged Omarchy runtime"

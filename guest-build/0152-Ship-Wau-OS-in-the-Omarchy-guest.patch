@@ -0,0 +1,48 @@
+#!/bin/bash
+
+# Wau OS inside Omarchy: the app, its menu entry, its theme hook, its keys, and the autostart
+# entry that opens it with the session.
+#
+# Every step is idempotent, and every step is optional: a machine without Wau OS installed skips
+# this whole script, and a step that fails leaves the rest of the first-run alone. The first-run
+# runner logs what happened either way.
+#
+# Nothing here starts a service that outlives the session. The Wau OS app starts and owns its own
+# Hermes backend, so it is ready the moment it opens. A Hermes gateway that runs in the
+# background (for a messaging bot, say) is the person's own call:
+# hermes gateway install --start-now --start-on-login
+
+set -uo pipefail
+
+if ! command -v herald-os >/dev/null 2>&1; then
+  echo "Wau OS is not installed on this machine; nothing to set up."
+  exit 0
+fi
+
+# The bridge plugin and the tools it needs: this is what lets Whis use the system. It installs
+# Hermes Agent as well when the machine has none yet (Omarchy's own Hermes Desktop runtime
+# counts, so the two never fight over ~/.hermes).
+if ! herald-os setup --yes; then
+  echo "Wau OS did not finish its setup; run herald-os setup in a terminal." >&2
+fi
+
+# The menu entry, the theme hook and the keys, so Wau OS looks and behaves like part of Omarchy
+# instead of a stranger inside it.
+if ! herald-os omarchy install; then
+  echo "Wau OS could not join the Omarchy menu; run herald-os omarchy install in a terminal." >&2
+fi
+
+# Wau OS opens with the session: the desktop entry every session reads at login. Without it a
+# login lands in Omarchy's own desktop, and Wau OS is one keypress away.
+autostart_dir="$HOME/.config/autostart"
+mkdir -p "$autostart_dir"
+cat >"$autostart_dir/wau-os.desktop" <<'DESKTOP'
+[Desktop Entry]
+Name=Wau OS
+Comment=Whis as your desktop
+Exec=herald-os omarchy start
+Icon=herald-os
+Type=Application
+Terminal=false
+StartupWMClass=herald-os
+DESKTOP
